# Copy this file to .env for local development.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Supabase project (Dashboard -> Connect). The publishable key is safe to expose;
# row-level security in supabase/schema.sql protects each user's data.
VITE_SUPABASE_URL="https://ngqpuwkwrqcuawflxkut.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_MXegG5FP1s-ixyytFAav5w_kJ4yngfk"

# Gemini (https://aistudio.google.com/apikey). Keep this secret; never commit .env.
GEMINI_API_KEY=""

# Free backup AI providers, tried in order when Gemini is busy. Leave blank to skip.
# Groq: https://console.groq.com/keys (free, no card, 1,000 requests/day, reads images)
GROQ_API_KEY=""
# OpenRouter: https://openrouter.ai/keys (free models, 50 requests/day without credits)
OPENROUTER_API_KEY=""

